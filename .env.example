REPLACEMENT_CHECK_MINUTES=10
AUTOPOST_ENABLED=true
BOT_WORKERS=4
TELEGRAM_MESSAGES_PER_SECOND=20
TELEGRAM_QUEUE_SIZE=1000
LOG_LEVEL=INFO
DATA_DIR=data
